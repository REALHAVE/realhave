# 리얼해브 환경변수 양식
# 이 파일을 복사해서 같은 폴더에 ".env.local" 이라는 이름으로 만든 뒤, = 뒤에 값을 붙여넣으세요.
# .env.local 은 GitHub에 올라가지 않습니다. (이 양식 파일만 올라감)
#
# 값 찾는 곳: Supabase 프로젝트 → Project Settings → API Keys (URL은 Data API 또는 Connect 화면)

# 프로젝트 주소 (예: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 공개용 키: "Publishable key" (sb_publishable_ 로 시작). 없으면 Legacy 탭의 "anon public" 키
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ secret / service_role 키는 여기에 넣지 마세요. (지금 단계에서는 필요 없음)
